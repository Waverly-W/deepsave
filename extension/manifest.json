{
  "manifest_version": 3,
  "name": "DeepSave Pro",
  "description": "Save pages and notes to DeepSave Pro",
  "version": "0.1.0",
  "permissions": ["storage", "contextMenus", "activeTab", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "DeepSave Pro",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/grey-16.png",
      "32": "icons/grey-32.png",
      "128": "icons/grey-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/grey-16.png",
    "32": "icons/grey-32.png",
    "128": "icons/grey-128.png"
  }
}
